---
interface Props {
  title: string;
  className?: string;
}

const { title, className } = Astro.props;
import Footer from "@/components/Footer";
import Navbar from "@/components/Navbar";
import { twMerge } from "tailwind-merge";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- favicon -->
    <link
      rel="shortcut icon"
      href="/src/assets/favicon.ico"
      type="image/x-icon"
    />
    <link rel="apple-touch-icon" href="/src/assets/favicon.ico" />

    <title>{title}</title>
  </head>

  <body class="font-mulish antialiased">
    <header class="fixed top-0 left-0 z-50 h-20 w-full bg-white">
      <Navbar />
    </header>

    <main class="relative isolate mt-20 min-h-screen">
      <section
        class={twMerge(
          "mx-auto h-full w-full max-w-7xl px-4 lg:px-0",
          `${className}`,
        )}
      >
        <!-- YOUR CHILDREN HERE -->
        <slot />
      </section>
    </main>

    <footer class="relative isolate">
      <Footer />
    </footer>
  </body>
</html>
